Algoritmo "quadrado, cubo e difereca"

Var
n: inteiro
quadrado, cubo : inteiro 
diferenca: real

Inicio
leia(n)

se (n > 0) entao
    
    quadrado <- (n * n)
    cubo <- (n * n * n)
    diferenca <- (n / 5)
    escreva(quadrado, cubo, diferenca)
senao
    escreva(numero invalido)
fimse    



Fimalgoritmo